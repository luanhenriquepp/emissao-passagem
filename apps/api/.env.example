# Porta da API
PORT=3000
# Origens permitidas no CORS (front em dev)
CORS_ORIGINS=http://localhost:4200
# Cria sessão demo automaticamente quando não há cookie (deixe false em produção)
AUTO_LOGIN=true
# Fontes de tarifa mockadas (MILES,CONSOLIDATOR,PUBLIC,AIRLINE_AGREEMENT)
FARE_SOURCES=MILES,CONSOLIDATOR,PUBLIC
# Probabilidade de uma fonte falhar (0–1) para testar snapshot degradado
SOURCE_FAILURE_RATE=0
# Limite de buscas novas por janela (plano Gratuito)
SEARCH_LIMIT_PER_WINDOW=30
SEARCH_WINDOW_SECONDS=600
# Emissão simulada: booked | stuck | failed | random
ISSUANCE_OUTCOME=random
ISSUANCE_DELAY_MS=4000
STUCK_RESOLVE_MS=20000
# Depósito PIX mock confirma sozinho após N segundos
DEPOSIT_AUTO_CONFIRM_SECONDS=5
# Saldo inicial da carteira demo
DEMO_INITIAL_BALANCE=0
